<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#101827">
  <title><%= titulo %></title>
  <link rel="icon" type="image/svg+xml" href="/img/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/csrf.js"></script>
</head>
<body class="dashboard-page">
<div class="sf-layout">
  <aside class="sf-sidebar" id="menu-lateral">
    <a class="sf-brand" href="/dashboard"><span class="sf-brand-mark"><svg viewBox="0 0 32 32" aria-hidden="true"><rect x="6" y="16" width="5" height="9" rx="1.3" fill="currentColor"/><rect x="13.5" y="11" width="5" height="14" rx="1.3" fill="currentColor"/><rect x="21" y="6" width="5" height="19" rx="1.3" fill="currentColor"/></svg></span><span>sales<span>flow</span></span></a>
    <div class="sf-nav-label">MENU PRINCIPAL</div>
    <nav class="sf-nav"><a class="sf-nav-item" href="/dashboard"><span class="sf-nav-icon"><svg class="sf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg></span><span>Visão geral</span></a></nav>
    <div class="sf-nav-label sf-nav-label-spaced">GESTÃO COMERCIAL</div>
    <nav class="sf-nav" aria-label="Módulos de gestão">
      <a class="sf-nav-item " href="/produtos"><span class="sf-nav-icon"><svg class="sf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8 12 3 3 8v8l9 5 9-5z"/><path d="m3 8 9 5 9-5M12 13v8"/></svg></span><span>Produtos</span></a>
      <a class="sf-nav-item is-active" href="/categorias"><span class="sf-nav-icon"><svg class="sf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.2"/></svg></span><span>Categorias</span></a>
      <a class="sf-nav-item" href="/clientes"><span class="sf-nav-icon"><svg class="sf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6M16 4.7a3.5 3.5 0 0 1 0 6.6M18 14.3c2.2.7 3.5 2.6 3.5 5.2"/></svg></span><span>Clientes</span></a>
      <a class="sf-nav-item" href="/vendas"><span class="sf-nav-icon"><svg class="sf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2h12v20l-3-2-3 2-3-2-3 2z"/><path d="M9 7h6M9 11h6M9 15h4"/></svg></span><span>Vendas</span></a>
      <a class="sf-nav-item" href="/relatorios"><span class="sf-nav-icon"><svg class="sf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="M7 15v-4M12 15V7M17 15v-6"/></svg></span><span>Relatórios</span></a>
    </nav>
    <div class="sf-sidebar-bottom"><div class="sf-company-card"><span class="sf-company-indicator"></span><div><small>EMPRESA ATIVA</small><strong><%= empresaNome %></strong></div></div></div>
  </aside>
  <div class="sf-backdrop" id="menu-fundo" hidden></div>
  <div class="sf-main">
    <header class="sf-topbar">
      <button class="sf-menu-toggle" type="button" id="btn-menu" aria-label="Abrir menu" aria-controls="menu-lateral" aria-expanded="false"><svg class="sf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
        <div class="sf-breadcrumb"><a href="/dashboard">SalesFlow</a><i>/</i><strong>Categorias</strong></div>
      <div class="sf-topbar-right">
        <div class="sf-user-chip"><span class="sf-user-avatar"><%= (usuario.nome || 'U').charAt(0).toUpperCase() %></span><span class="sf-user-name"><%= usuario.nome %></span></div>
        <button id="btn-logout" class="sf-logout" type="button">Sair <span aria-hidden="true">↗</span></button>
      </div>
    </header>
    <main class="sf-content">
      <section class="sf-page-heading">
        <div><span class="sf-eyebrow">ORGANIZAÇÃO DO CATÁLOGO</span><h1>Categorias</h1><p>Organize os produtos da empresa em grupos fáceis de encontrar.</p></div>
      </section>
      <section class="sf-module-two-col">
        <article class="sf-panel sf-category-form-panel">
          <div class="sf-panel-heading"><div><h2 id="titulo-form-categoria">Nova categoria</h2><p>O nome deve ser único dentro da sua empresa.</p></div></div>
          <form id="form-categoria" class="sf-category-form">
            <input type="hidden" name="id">
            <label>Nome da categoria<input name="nome" maxlength="60" required placeholder="Ex.: Eletrônicos"></label>
            <div class="sf-modal-actions"><button class="sf-secondary-button" type="button" id="cancelar-edicao-categoria" hidden>Cancelar edição</button><button class="sf-primary-button" type="submit">Salvar categoria</button></div>
          </form>
          <p id="mensagem-categoria" class="form-message" role="status" aria-live="polite"></p>
        </article>
        <article class="sf-panel">
          <div class="sf-panel-heading"><div><h2>Categorias cadastradas</h2><p><%= categorias.length %> categoria(s) na sua empresa</p></div></div>
          <% if (categorias.length) { %>
            <div class="sf-category-list">
              <% categorias.forEach(c => { %>
                <div class="sf-category-row">
                  <div><strong><%= c.nome %></strong><small><%= c.total_produtos %> produto(s)</small></div>
                  <div class="sf-actions-cell"><button type="button" class="sf-table-action" data-edit-category="<%= c.id %>" data-category-name="<%= c.nome %>">Editar</button><button type="button" class="sf-table-action is-danger" data-delete-category="<%= c.id %>">Excluir</button></div>
                </div>
              <% }) %>
            </div>
          <% } else { %><div class="sf-empty-small"><strong>Nenhuma categoria cadastrada</strong><p>Crie uma categoria para começar a cadastrar produtos.</p></div><% } %>
        </article>
      </section>
      <footer class="sf-footer">SalesFlow <span>·</span> Gestão comercial e inteligência de vendas</footer>
      <p id="mensagem-dashboard" class="form-message" role="alert" aria-live="polite"></p>
    </main>
  </div>
</div>
<script src="/js/auth.js" defer></script>
<script src="/js/menu.js" defer></script>
<script src="/js/tabelas.js" defer></script>
<script src="/js/gestao.js" defer></script>
</body>
</html>
