# Copie este arquivo para ".env" e preencha com os seus dados.
# O arquivo ".env" NUNCA vai para o GitHub (ele está no .gitignore).

PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=coloque_aqui_a_senha_do_seu_mysql
DB_NAME=salesflow
SESSION_SECRET=gere_um_segredo_aleatorio
# Opcional: só se publicar atrás de proxy (Render, Railway, Nginx). Use 1.
# TRUST_PROXY=1
